{
  "name": "moeloader-e",
  "version": "0.1.0",
  "description": "MoeLoaderE desktop image browser and downloader",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --ignoreConfigWarning",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build --ignoreConfigWarning",
    "start": "electron-vite preview --skipBuild --ignoreConfigWarning",
    "test": "npm run build && node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "test:online": "npm run build && node tests/online.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "koffi": "3.3.0"
  }
}
